<Slide style={{
    width: '1280px',
    height: '720px',
    position: 'relative',
    background: '#F7F3EA',
    padding: 0,
    fontFamily: '"PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif',
}}>
    <Box style={{
        position: 'absolute',
        top: 0, left: 0,
        width: '328px', height: '720px',
        background: '#0B3D2E',
        padding: '70px 40px 56px 72px',
        flexDirection: 'column',
        justifyContent: 'space-between',
    }}>
        <Box style={{ flexDirection: 'column', gap: 16 }}>
            <Box style={{ width: 40, height: 3, background: '#C75B12' }} />
            <Text style={{
                fontSize: 46,
                fontWeight: 'bold',
                color: '#F7F3EA',
                lineHeight: 1.3,
                letterSpacing: 4,
                fontFamily: 'Georgia, "Songti SC", "STSong", serif',
            }}>
                三個
                <br />
                不是
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(247,243,234,.60)', lineHeight: 1.72 }}>
            主持不是表演，而是一套讓別人有效說話的技術。
        </Text>
    </Box>

    <Box style={{
        position: 'absolute',
        top: 0, right: 0,
        width: '952px', height: '720px',
        padding: '64px 68px 52px 48px',
        flexDirection: 'column',
    }}>
        <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'center', height: 62 }}>
            <Box style={{ width: 4, height: 34, background: '#C75B12' }} />
            <Text style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#0B3D2E',
                letterSpacing: 1,
                fontFamily: 'Georgia, "Songti SC", "STSong", serif',
            }}>
                主持人的三個角色定位
            </Text>
        </Box>

        <Box style={{ flex: 1, minWidth: 0, minHeight: 0, flexDirection: 'column', gap: 14, paddingTop: 14 }}>
            {[
                { i: 'user', n: '不是最會講的人', d: '主持人的本事不在於表達，而在了讓所有人在同一個時間裡有效討論；一場會裡如果最多的時間是主講人自己在說，那這場會的問題不在設備，在人選。' },
                { i: 'comments', n: '不是發言最多的人', d: '主持人說得越多，通常意味著其他人說得太少，而會議的資訊恰恰藏在那些沒有被問到的人身上；合格的主持人要做的，是把話從自己嘴裡轉到別人嘴裡。' },
                { i: 'handshake', n: '不是討好所有人的人', d: '會議不是征求一致意見的場合，試圖讓每一個人都滿意地離開，往往意味著所有人都可以不承擔結果——包括組織。' },
            ].map((item, idx) => (
                <Box key={item.n} style={{
                    flex: 1, minWidth: 0, minHeight: 0,
                    flexDirection: 'row',
                    gap: 20,
                    alignItems: 'center',
                    background: '#FFFFFF',
                    borderLeft: '4px solid #C75B12',
                    borderRadius: 6,
                    padding: '20px 26px',
                    boxShadow: '0 4px 20px rgba(11,61,46,.08)',
                }}>
                    <Box style={{
                        width: 52, height: 52, borderRadius: 26,
                        background: 'rgba(11,61,46,.07)',
                        justifyContent: 'center', alignItems: 'center',
                    }}>
                        <FAIcon name={item.i} style={{ fill: '#0B3D2E', width: 26, height: 26 }} />
                    </Box>
                    <Box style={{ flex: 1, minWidth: 0, minHeight: 0, flexDirection: 'column', gap: 7 }}>
                        <Text style={{ fontSize: 23, fontWeight: 600, color: '#0B3D2E', letterSpacing: 1 }}>
                            {item.n}
                        </Text>
                        <Text style={{ fontSize: 16, color: '#5C5850', lineHeight: 1.66 }}>
                            {item.d}
                        </Text>
                    </Box>
                    <Text style={{
                        fontSize: 34,
                        fontWeight: 'bold',
                        color: 'rgba(11,61,46,.14)',
                        fontFamily: 'Georgia, "Songti SC", serif',
                    }}>
                        0{idx + 1}
                    </Text>
                </Box>
            ))}
        </Box>

        <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: 14 }}>
            <Text style={{ fontSize: 14, color: '#8A8578', letterSpacing: 1 }}>高效會議主持 SOP</Text>
            <Text style={{ fontSize: 14, color: '#8A8578', letterSpacing: 1 }}>07 / 14</Text>
        </Box>
    </Box>
</Slide>
