<Slide style={{
    width: '1280px',
    height: '720px',
    position: 'relative',
    background: '#0B3D2E',
    padding: 0,
    fontFamily: '"PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif',
}}>
    <Image src="assets/chapter_1.png" style={{
        position: 'absolute',
        top: 0, left: 0,
        width: '100%', height: '100%',
        objectFit: 'cover',
        opacity: 0.22,
    }} />
    <Box style={{
        position: 'absolute',
        top: 0, left: 0,
        width: '100%', height: '100%',
        background: 'linear-gradient(180deg, rgba(11,61,46,.96) 0%, rgba(11,61,46,.86) 50%, rgba(11,61,46,.96) 100%)',
    }} />

    <Box style={{
        position: 'absolute',
        top: 0, left: 0,
        width: '100%', height: '720px',
        padding: '76px 72px 60px 72px',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'space-between',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, alignSelf: 'flex-start' }}>
            <Box style={{ width: 40, height: 3, background: '#C75B12' }} />
            <Text style={{ fontSize: 15, color: 'rgba(247,243,234,.62)', letterSpacing: 3 }}>
                CHAPTER
            </Text>
        </Box>

        <Box style={{ flexDirection: 'column', gap: 24, alignItems: 'center' }}>
            <Text style={{
                fontSize: 132,
                fontWeight: 'bold',
                color: 'transparent',
                backgroundImage: 'linear-gradient(160deg, #C75B12 0%, #F0A050 100%)',
                backgroundClip: 'text',
                lineHeight: 0.96,
                fontFamily: 'Georgia, "Songti SC", serif',
            }}>
                03
            </Text>
            <Box style={{ width: 96, height: 2, background: 'rgba(240,160,80,.5)' }} />
            <Text style={{
                fontSize: 56,
                fontWeight: 'bold',
                color: '#F7F3EA',
                lineHeight: 1.2,
                letterSpacing: 6,
                textAlign: 'center',
                fontFamily: 'Georgia, "Songti SC", "STSong", serif',
            }}>
                決策與收束
            </Text>
            <Text style={{
                fontSize: 21,
                color: 'rgba(247,243,234,.80)',
                lineHeight: 1.72,
                textAlign: 'center',
                maxWidth: 660,
                marginTop: 8,
            }}>
                討論和表決是兩個階段，不要混在一起。
            </Text>
        </Box>

        <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', alignSelf: 'stretch' }}>
            <Text style={{ fontSize: 14, color: 'rgba(247,243,234,.48)', letterSpacing: 1 }}>高效會議主持 SOP</Text>
            <Text style={{ fontSize: 14, color: 'rgba(247,243,234,.48)', letterSpacing: 1 }}>10 / 14</Text>
        </Box>
    </Box>
</Slide>
