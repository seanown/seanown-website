<Slide style={{
    width: '1280px',
    height: '720px',
    position: 'relative',
    background: '#F7F3EA',
    padding: 0,
    fontFamily: '"PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif',
}}>
    <Box style={{
        position: 'absolute',
        top: 0, left: 0,
        width: '704px', height: '720px',
    }}>
        <Image src="assets/meeting_scene.png" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
        <Box style={{
            position: 'absolute',
            top: 0, left: 0,
            width: '100%', height: '100%',
            background: 'linear-gradient(180deg, rgba(11,61,46,.30) 0%, rgba(11,61,46,.10) 45%, rgba(11,61,46,.72) 100%)',
        }} />
        <Box style={{
            position: 'absolute',
            bottom: 52, left: 56,
            flexDirection: 'column', gap: 8,
        }}>
            <Text style={{ fontSize: 15, color: '#F0A050', letterSpacing: 3, fontWeight: 600 }}>
                THE ORDINARY MEETING
            </Text>
            <Text style={{ fontSize: 25, color: '#F7F3EA', fontWeight: 600, letterSpacing: 1 }}>
                一場普通會議的實際去向
            </Text>
        </Box>
    </Box>

    <Box style={{
        position: 'absolute',
        top: 0, right: 0,
        width: '576px', height: '720px',
        padding: '56px 64px 52px 52px',
        flexDirection: 'column',
    }}>
        <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'center', height: 64 }}>
            <Box style={{ width: 4, height: 34, background: '#C75B12' }} />
            <Text style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#0B3D2E',
                letterSpacing: 1,
                fontFamily: 'Georgia, "Songti SC", "STSong", serif',
            }}>
                四個小時去了哪裡
            </Text>
        </Box>

        <Box style={{ flex: 1, minWidth: 0, minHeight: 0, flexDirection: 'column', justifyContent: 'space-between', paddingTop: 20 }}>
            {[
                { m: '20', t: '分鐘　寒暄與調試', d: '主辦方發材料、調麥克風、確認誰來了——這些事不該占用任何人的注意力。' },
                { m: '30', t: '分鐘　講背景', d: '由級別最高的人說明背景，而這部分內容在場所有人早已知道。' },
                { m: '60', t: '分鐘　反覆橫跳', d: '圍繞一個誰也拍不了板的問題反覆討論，直到所有人都累了。' },
                { m: '10', t: '分鐘　念決議', d: '主持人念一遍決議，念完沒有人問「誰做、何時完成」。' },
            ].map((item, idx) => (
                <Box key={item.m} style={{
                    flexDirection: 'row',
                    gap: 18,
                    alignItems: 'flex-start',
                    paddingBottom: idx === 3 ? 0 : 16,
                }}>
                    <Text style={{
                        fontSize: 44,
                        fontWeight: 'bold',
                        color: idx === 3 ? '#C75B12' : 'rgba(11,61,46,.30)',
                        lineHeight: 1,
                        width: 72,
                        textAlign: 'right',
                        fontFamily: 'Georgia, "Songti SC", serif',
                    }}>
                        {item.m}
                    </Text>
                    <Box style={{ flex: 1, minWidth: 0, minHeight: 0, flexDirection: 'column', gap: 6, borderLeft: '2px solid rgba(199,91,18,.34)', paddingLeft: 18 }}>
                        <Text style={{ fontSize: 21, fontWeight: 600, color: '#0B3D2E', letterSpacing: 1 }}>
                            {item.t}
                        </Text>
                        <Text style={{ fontSize: 15, color: '#5C5850', lineHeight: 1.62 }}>
                            {item.d}
                        </Text>
                    </Box>
                </Box>
            ))}
        </Box>

        <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: 14 }}>
            <Text style={{ fontSize: 14, color: '#8A8578', letterSpacing: 1 }}>高效會議主持 SOP</Text>
            <Text style={{ fontSize: 14, color: '#8A8578', letterSpacing: 1 }}>04 / 14</Text>
        </Box>
    </Box>
</Slide>
